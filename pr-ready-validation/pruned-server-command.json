{
  "command": [
    "/root/shared-nvme/vllm/.venv/bin/python",
    "-m",
    "vllm.entrypoints.cli.main",
    "serve",
    "/root/shared-nvme/models/Qwen2.5-7B-Instruct",
    "--served-model-name",
    "qwen25-ffn",
    "--host",
    "127.0.0.1",
    "--port",
    "18081",
    "--dtype",
    "bfloat16",
    "--max-model-len",
    "8192",
    "--max-num-seqs",
    "4",
    "--max-num-batched-tokens",
    "16384",
    "--gpu-memory-utilization",
    "0.85",
    "--no-enable-prefix-caching",
    "--no-enable-chunked-prefill",
    "--attention-config",
    "{\"backend\": \"FLASH_ATTN\", \"flash_attn_version\": 2}",
    "--compilation-config",
    "{\"mode\": 0, \"cudagraph_mode\": \"FULL_AND_PIECEWISE\", \"prefill_cudagraph_capture_token_sizes\": [512, 2048, 4096, 8192, 16384], \"decode_cudagraph_capture_request_sizes\": [1, 2, 4]}"
  ],
  "env": {
    "VLLM_ENABLE_LAST_LAYER_FFN_PRUNING": "1",
    "VLLM_USE_BREAKABLE_CUDAGRAPH": "1",
    "VLLM_USE_RUST_FRONTEND": "0"
  }
}